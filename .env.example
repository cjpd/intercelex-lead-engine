# Copy to .env and fill in. .env is gitignored.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# Default model for agent calls. Sonnet for production, Haiku for cheap eval reruns.
INTERCELEX_MODEL=claude-sonnet-4-6
INTERCELEX_FAST_MODEL=claude-haiku-4-5-20251001

# --- Data sources (all public; keys are free) ---
# https://quickstats.nass.usda.gov/api
NASS_API_KEY=

# USDA Organic INTEGRITY ships as bulk download, no key required
# FDACS nursery licenses ship as bulk download, no key required
# NOAA / NWS Miami: no key required for the products we use

# --- Storage ---
# Path to local SQLite file. Never commit this file.
INTERCELEX_DB_PATH=./data/intercelex.db

# --- Observability (optional) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
